diff --git a/bsd/dev/whyred_gpu.c b/bsd/dev/whyred_gpu.c
new file mode 100644
index 0000000..4ce875b
--- /dev/null
+++ b/bsd/dev/whyred_gpu.c
@@ -0,0 +1,99 @@
+/* Whyred SDM636/A509 bring-up, phase 1. No GPU power or DMA writes.
+ * GCC base: captured whyred live FDT; branch offsets: Linux v6.12 gcc-sdm660.c.
+ * Firmware loader: existing XNU topaz_fw.c, used only as a filesystem reader.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int topaz_fw_read(const char *, void **, size_t *);
+extern void topaz_fw_free(void *, size_t);
+extern int topaz_root_mounted(void);
+
+#define WGCC_PAGE 0x00170000UL
+#define WGCC_SIZE 0x4000UL
+#define WGCC_AHB  0x1004U
+#define WGCC_BIMC 0x1010U
+#define WBIMC_GFX 0x106cU
+#define WGATE_OFF (1U << 31)
+#define FWPATH "/usr/share/firmware/whyred/"
+
+static LCK_GRP_DECLARE(wgpu_grp, "whyred_gpu");
+static LCK_MTX_DECLARE(wgpu_lock, &wgpu_grp);
+static vm_offset_t wgcc;
+
+static bool
+wgpu_enabled(void)
+{
+    uint32_t on = 0;
+    return PE_parse_boot_argn("whyred_gpu", &on, sizeof(on)) && on == 1;
+}
+
+static uint32_t
+wgpu_read(uint32_t off)
+{
+    return *(volatile uint32_t *)(wgcc + off);
+}
+
+static int
+wgpu_clocks SYSCTL_HANDLER_ARGS
+{
+    char report[320];
+    if (!wgpu_enabled()) return ENXIO;
+    if (req->newptr != 0) return EPERM;
+    lck_mtx_lock(&wgpu_lock);
+    if (wgcc == 0) wgcc = ml_io_map(WGCC_PAGE, WGCC_SIZE);
+    if (wgcc == 0) {
+        lck_mtx_unlock(&wgpu_lock);
+        return ENOMEM;
+    }
+    uint32_t a = wgpu_read(WGCC_AHB);
+    uint32_t b = wgpu_read(WGCC_BIMC);
+    uint32_t c = wgpu_read(WBIMC_GFX);
+    lck_mtx_unlock(&wgpu_lock);
+    snprintf(report, sizeof(report),
+        "A509 GCC clock gates (raw, no writes): cfg_ahb=0x%08x [%s] gpu_bimc=0x%08x [%s] bimc_gfx=0x%08x [%s]",
+        a, (a & WGATE_OFF) ? "off" : "not-off", b, (b & WGATE_OFF) ? "off" : "not-off",
+        c, (c & WGATE_OFF) ? "off" : "not-off");
+    return SYSCTL_OUT(req, report, strlen(report) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, whyred_gpu_clocks, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, wgpu_clocks, "A", "Whyred A509 read-only GCC branch state; whyred_gpu=1");
+
+static int
+wgpu_firmware SYSCTL_HANDLER_ARGS
+{
+    static const char *const paths[] = {
+        FWPATH "a530_pm4.fw", FWPATH "a530_pfp.fw", FWPATH "a512_zap.mdt", FWPATH "a512_zap.b02"
+    };
+    char report[384];
+    int err[4];
+    size_t sz[4];
+    if (!wgpu_enabled()) return ENXIO;
+    if (req->newptr != 0) return EPERM;
+    if (!topaz_root_mounted()) return ENXIO;
+    for (unsigned i = 0; i < 4; i++) {
+        void *data = NULL;
+        sz[i] = 0;
+        err[i] = topaz_fw_read(paths[i], &data, &sz[i]);
+        if (!err[i]) {
+            if (i < 2 && (sz[i] < 8 || (sz[i] & 3))) err[i] = EINVAL;
+            if (i == 2 && (sz[i] < 52 || memcmp(data, "\177ELF\1\1", 6) != 0)) err[i] = EINVAL;
+            if (i == 3 && sz[i] == 0) err[i] = EINVAL;
+            topaz_fw_free(data, sz[i]);
+        }
+    }
+    snprintf(report, sizeof(report),
+        "firmware probe only: pm4=%lu bytes errno=%d; pfp=%lu bytes errno=%d; zap_mdt=%lu bytes errno=%d; zap_b02=%lu bytes errno=%d",
+        (unsigned long)sz[0], err[0], (unsigned long)sz[1], err[1], (unsigned long)sz[2], err[2], (unsigned long)sz[3], err[3]);
+    return SYSCTL_OUT(req, report, strlen(report) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, whyred_gpu_firmware, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, wgpu_firmware, "A", "Whyred A509 firmware presence and basic format only; no GPU upload");
+#endif
