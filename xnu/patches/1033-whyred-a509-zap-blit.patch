+/* Phase 7: authenticate the original signed a512_zap using the existing
+ * Qualcomm SCM implementation. Android's observed ZAP allocation was
+ * 0xfca00000..0xfca02000, within its excluded CMA pool (not XNU RAM).
+ * No forced PAS shutdown, no write to SECVID_TRUST_CNTL, no bypass of TZ.
+ * Only mode 2/3 uses PAS; mode 3 additionally tests a fixed 2D RGBA copy.
+ */
+static whyred_a509_buffer wa509_zap_meta;
+static uint32_t wa509_get32(const uint8_t *p) { uint32_t x; memcpy(&x,p,4); return x; }
+static uint16_t wa509_get16(const uint8_t *p) { uint16_t x; memcpy(&x,p,2); return x; }
+static bool
+wa509_zap_pas(void)
+{
+    const void *v[4]={}; size_t n[4]={};
+    const char *names[]={"a512_zap.mdt","a512_zap.b00","a512_zap.b01","a512_zap.b02"};
+    for (unsigned i=0;i<4;i++)
+        if (whyred_gpu_get_bootfw(names[i],&v[i],&n[i]) || !v[i] || !n[i]) return false;
+    const uint8_t *m=(const uint8_t *)v[0], *h=(const uint8_t *)v[2];
+    if (n[0]<148 || memcmp(m,"\177ELF\1\1",6) || wa509_get32(m+28)!=52 ||
+        wa509_get16(m+42)!=32 || wa509_get16(m+44)!=3 || n[1]!=148 || memcmp(m,v[1],148)) return false;
+    const uint8_t *p0=m+52,*p1=m+84,*p2=m+116;
+    uint32_t hlen=wa509_get32(p1+16), hoff=wa509_get32(p1+4),
+        files=wa509_get32(p2+16), mem=wa509_get32(p2+20), flags=wa509_get32(p2+24);
+    if (wa509_get32(p0)==1 || wa509_get32(p0+16)!=148 || ((wa509_get32(p1+24)>>24)&7)!=2 ||
+        hlen!=n[2] || hlen>PAGE_SIZE-148 || wa509_get32(p2)!=1 || ((flags>>24)&7)==2 ||
+        !(flags&(1U<<27)) || wa509_get32(p2+12)!=0x5000 || files!=n[3] || !files || files>mem ||
+        mem>0x2000 || ((mem+4095)&~4095U)!=0x2000) return false;
+    if (n[0]==148+hlen) { if (memcmp(m+148,h,hlen)) return false; }
+    else if (hoff<=n[0] && hlen<=n[0]-hoff) { if (memcmp(m+hoff,h,hlen)) return false; }
+    if (!whyred_a509_alloc(&wa509_zap_meta,148+hlen)) return false;
+    memcpy(wa509_zap_meta.va,m,148); memcpy(wa509_zap_meta.va+148,h,hlen);
+    __asm__ volatile("dsb sy" ::: "memory");
+    // Reserve and map only the recorded 16 KiB-aligned CMA subregion; it
+    // is never part of the main or extra XNU RAM ranges. Map before PAS.
+    const uint64_t base=0xfca00000ULL;
+    IOMemoryDescriptor *md=IOMemoryDescriptor::withPhysicalAddress(base,0x4000,kIODirectionInOut);
+    if (!md) return false;
+    IOMemoryMap *map=md->map(kIOMapWriteCombineCache); md->release();
+    if (!map) return false;
+    uint64_t res=0, st=scm(SCM_FN(SCM_SVC_PIL,PIL_INIT_IMAGE),2|(SCM_ARG_RW<<6),13,wa509_zap_meta.pa,0,&res);
+    IOLog("A509: ZAP_INIT ret=%llx res=%llx\n",(unsigned long long)st,(unsigned long long)res);
+    if (st || res) {map->release();return false;}
+    st=scm(SCM_FN(SCM_SVC_PIL,PIL_MEM_SETUP),3,13,base,0x2000,&res);
+    IOLog("A509: ZAP_MEM ret=%llx res=%llx\n",(unsigned long long)st,(unsigned long long)res);
+    if (st || res) {map->release();return false;}
+    volatile uint8_t *dst=(volatile uint8_t *)map->getVirtualAddress();
+    if (!dst) {map->release();return false;}
+    const uint8_t *seg=(const uint8_t *)v[3];
+    for (unsigned i=0;i<0x2000;i++) dst[i]=i<files?seg[i]:0;
+    __asm__ volatile("dsb sy" ::: "memory");
+    map->release(); // never access authenticated memory after TZ takes ownership
+    st=scm(SCM_FN(SCM_SVC_PIL,PIL_AUTH_RESET),1,13,0,0,&res);
+    IOLog("A509: ZAP_AUTH ret=%llx res=%llx\n",(unsigned long long)st,(unsigned long long)res);
+    return st==0 && res==0;
+}
