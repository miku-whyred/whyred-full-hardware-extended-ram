+/* Fixed 32x32 RGBA8 -> RGBA8 copy; hardware register programming follows
+ * the public A5xx packet format and Mesa fd5_blitter.c. No arbitrary
+ * command stream, addresses, dimensions or register writes from userspace.
+ * Mesa source: https://chromium.googlesource.com/external/gitlab.freedesktop.org/mesa/mesa/+/41ddaf0ba41c54dddd1005afa5fe21b5d4e00ffb/src/gallium/drivers/freedreno/a5xx/fd5_blitter.c
+ */
+static uint32_t wa509_pkt4(uint32_t reg,uint32_t count)
+{
+    return 0x40000000U|count|(whyred_a509_odd(count)<<7)|(reg<<8)|(whyred_a509_odd(reg)<<27);
+}
+static uint32_t wa509_pixel(unsigned i) {return 0xff000000U|((i*37U)&255)|(((i*73U)&255)<<8)|(((i*109U)&255)<<16);}
+static bool
+wa509_blit_test(vm_offset_t gpu,vm_offset_t cb,uint32_t wp)
+{
+    auto &s=wa509_cp;
+    uint32_t *src=(uint32_t *)s.src.va,*dst=(uint32_t *)s.dst.va,*rb=(uint32_t *)s.ring.va;
+    if (!src || !dst || wp+128>=s.ring.size/4) return false;
+    for (unsigned i=0;i<1024;i++) {src[i]=wa509_pixel(i);dst[i]=~src[i];}
+    // Leave padding unchanged, catch a write outside the expected 4096 bytes.
+    for (uint64_t i=1024;i<s.dst.size/4;i++) dst[i]=0xdeadbeef;
+    volatile uint32_t *f=(volatile uint32_t *)s.fence.va;
+    f[1]=0;
+    auto emit=[&](uint32_t x){rb[wp++]=x;};
+    auto reg=[&](uint32_t r,uint32_t x){emit(wa509_pkt4(r,1));emit(x);};
+    auto packet=[&](uint32_t op,uint32_t cnt){emit(whyred_a509_pkt7(op,cnt));};
+    packet(0x26,0);
+    const uint32_t setup[][2]={{0xe141,8},{0x2100,0x86000000},{0x2180,0x86000000},{0x2184,9},
+        {0xe140,1U<<17},{0x0cc6,4},{0x0ec2,12},{0x0f02,0x344},{0x0e06,2},{0xe000,0x181}};
+    for (auto &p:setup) reg(p[0],p[1]);
+    packet(0x6c,1);emit(5); // BLIT2D
+    for (unsigned i=0;i<2;i++) {
+        uint64_t a=wa509_iova[4+i];
+        emit(wa509_pkt4(i?0x2110:0x2107,9));
+        emit(0x30);emit((uint32_t)a);emit((uint32_t)(a>>32));
+        emit(2U|(64U<<16)); // 128 byte pitch, 4096 byte array pitch
+        for (unsigned j=0;j<5;j++) emit(0);
+        reg(i?0x2182:0x2181,0x30);
+    }
+    packet(0x2c,5);emit(1);emit(0);emit(31U|(31U<<16));emit(0);emit(31U|(31U<<16));
+    packet(0x6c,1);emit(8); // END2D
+    packet(0x26,0);
+    uint64_t fence=wa509_iova[3]+4;
+    packet(0x46,4);emit(0x1d);emit((uint32_t)fence);emit((uint32_t)(fence>>32));emit(0);
+    packet(0x46,4);emit(4);emit((uint32_t)fence);emit((uint32_t)(fence>>32));emit(0xa509b117U);
+    packet(0x26,0);
+    __asm__ volatile("dsb sy" ::: "memory");
+    wa509_cp_gw(gpu,0x0807,wp);
+    if (!wa509_cp_wait(gpu,cb,wp)) return false;
+    __asm__ volatile("dsb sy" ::: "memory");
+    unsigned bad=0;
+    for (unsigned i=0;i<1024;i++) if (((volatile uint32_t *)dst)[i]!=wa509_pixel(i)) bad++;
+    for (uint64_t i=1024;i<s.dst.size/4;i++) if (((volatile uint32_t *)dst)[i]!=0xdeadbeef) bad++;
+    IOLog("A509: BLIT_RGBA32 fence=%08x mismatches=%u\n",f[1],bad);
+    return f[1]==0xa509b117U && bad==0;
+}
