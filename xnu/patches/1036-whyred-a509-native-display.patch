+/* Optional SDM636 first stock OPP, not full DVFS. Vendor sources:
+ * gpucc-sdm660.c (640 MHz PLL /2 postdiv /2 RCG ->160 MHz),
+ * clk-alpha-pll.c (enable order), clk-rcg2.c (source 1/HID 3).
+ * No regulator writes, no MEMACC writes, no overclock, no shared clock changes.
+ * Refuse if current boot's CX/MX votes or MEMACC state are unconfirmed.
+ */
+static uint32_t wa509_clock_state;
+static bool wa509_clock_write(vm_offset_t cc,uint32_t off,uint32_t val)
+{
+    wgpu_mmio_write(cc,off,val);return wgpu_mmio_read(cc,off)==val;
+}
+static bool wa509_clock_root(vm_offset_t cc,uint32_t cfg)
+{
+    if (!wa509_rmw(cc,WGPUCC_RCG+4,0x371fU,cfg)) return false;
+    uint32_t cmd=wgpu_mmio_read(cc,WGPUCC_RCG);
+    if (cmd==0xffffffffU || (cmd&1U)) return false;
+    wgpu_mmio_write(cc,WGPUCC_RCG,cmd|1U);
+    return wa509_poll(cc,WGPUCC_RCG,0x80000001U,0) &&
+        (wgpu_mmio_read(cc,WGPUCC_RCG+4)&0x371fU)==cfg;
+}
