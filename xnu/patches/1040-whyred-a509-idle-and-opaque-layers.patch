+/* Up to four validated opaque rectangles. The union of covered x intervals
+ * changes only at a layer's top or bottom edge. Never scan old back-buffer
+ * pixels through a gap in the new frame. */
+static bool
+wa509_layers_cover(const wa509_layer *layers, unsigned n, uint32_t width, uint32_t height)
+{
+    for (uint32_t y = 0; y < height; ) {
+        uint32_t next_y = height;
+        for (unsigned i = 0; i < n; ++i) {
+            const auto &layer = layers[i];
+            if (layer.dy > y && layer.dy < next_y) next_y = layer.dy;
+            const uint32_t bottom = layer.dy + layer.h;
+            if (bottom > y && bottom < next_y) next_y = bottom;
+        }
+        for (uint32_t x = 0; x < width; ) {
+            uint32_t right = x;
+            for (unsigned i = 0; i < n; ++i) {
+                const auto &layer = layers[i];
+                if (layer.dy <= y && y < layer.dy + layer.h && layer.dx <= x &&
+                    layer.dx + layer.w > right) {
+                    right = layer.dx + layer.w;
+                }
+            }
+            if (right == x) return false;
+            x = right;
+        }
+        y = next_y;
+    }
+    return true;
+}
