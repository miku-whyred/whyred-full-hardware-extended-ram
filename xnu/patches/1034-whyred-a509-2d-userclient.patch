+/* Called with the service lock held, or by the initial boot selftest.
+ * 32-bit linear RGBA8. Pitch is the same for both buffers, in 64B units.
+ * All padding is initialized before execution; max 256x240 per request; 16 KiB tail guard.
+ * The ring is power-of-two and wraps only after the last job is idle. */
+static bool
+wa509_copy_geometry(uint64_t w,uint64_t h,uint64_t pitch)
+{
+    return w>0 && w<=256 && h>0 && h<=240 && pitch>=w*4 &&
+        pitch<=1024 && !(pitch&63) && pitch*h<=wa509_service_bytes-16384U;
+}
+static bool
+wa509_service_wait(vm_offset_t gpu,vm_offset_t cb,uint32_t wp,uint32_t seq)
+{
+    volatile uint32_t *f=(volatile uint32_t *)wa509_cp.fence.va;
+    uint64_t deadline;
+    clock_interval_to_deadline(250, NSEC_PER_MSEC, &deadline);
+    unsigned n=0;
+    for (;;) {
+        uint32_t fsr=wa509_cp_rd(cb,0x58),fault=wa509_cp_gr(gpu,0xb1a),
+            rp=wa509_cp_gr(gpu,0x806),status=wa509_cp_gr(gpu,0x4f5);
