+    fDst=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,kIODirectionInOut|kIOMemoryKernelUserShared,wa509_service_bytes,PAGE_SIZE);
+    if (!fSrc || !fDst || !fSrc->getBytesNoCopy() || !fDst->getBytesNoCopy()) return false;
+    bzero(fSrc->getBytesNoCopy(),wa509_service_bytes);bzero(fDst->getBytesNoCopy(),wa509_service_bytes);
+    return true;
+}
+void WhyredA509UserClient::free(void)
+{
+    if (fSlot) {IOLockLock(wa509_service_lock);--wa509_service_clients;fSlot=false;IOLockUnlock(wa509_service_lock);}
+    OSSafeReleaseNULL(fSrc);OSSafeReleaseNULL(fDst);
+    IOUserClient::free();
