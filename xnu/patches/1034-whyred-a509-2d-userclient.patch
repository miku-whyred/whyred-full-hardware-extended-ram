+IOReturn WhyredA509UserClient::clientClose(void)
+{
+    if (wa509_service_lock) {IOLockLock(wa509_service_lock);fClosed=true;IOLockUnlock(wa509_service_lock);}
+    if (!isInactive()) terminate();
+    return kIOReturnSuccess;
+}
+IOReturn WhyredA509UserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+    if (!options || !memory || !wa509_service_lock) return kIOReturnBadArgument;
+    IOLockLock(wa509_service_lock);
+    auto *b=(type==1?fSrc:type==2?fDst:nullptr);
+    IOReturn ret=kIOReturnBadArgument;
+    if (!fClosed && !wa509_service_dead && b) {b->retain();*memory=b;*options=0;ret=kIOReturnSuccess;}
+    IOLockUnlock(wa509_service_lock);
+    return ret;
+}
+IOReturn WhyredA509UserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch,__unused OSObject *target,__unused void *reference)
+{
