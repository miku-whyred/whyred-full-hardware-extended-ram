 /* Boot-time A509 phase 3. Register offsets in Linux v6.12 gcc-sdm660.c,
  * gpucc-sdm660.c and registers/adreno/a5xx.xml; physical bases in live FDT.
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
