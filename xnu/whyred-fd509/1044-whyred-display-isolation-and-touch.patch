+/* Until contexts are isolated per task, only the platform compositor and the root diagnostic may open one. */
+static bool
+whyredRenderClient(task_t task)
+{
+	if (task != current_task()) {
+		return false;
+	}
+	proc_t process = proc_self();
+	if (process == PROC_NULL) {
+		return false;
+	}
+	vnode_t executable = proc_getexecutablevnode(process);
+	proc_rele(process);
+	if (executable == NULL) {
+		return false;
+	}
+	const char *const paths[] = {
+		"/usr/libexec/backboardd", "/usr/libexec/real/backboardd", "/topaz/backboardd", "/var/root/gltest"
+	};
+	bool allow = false;
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vnode_t allowed = NULL;
+		if (vnode_lookup(paths[i], 0, &allowed, vfs_context_kernel()) == 0) {
+			allow = executable == allowed;
+			vnode_put(allowed);
+			if (allow) {
+				break;
+			}
+		}
+	}
+	vnode_put(executable);
+	return allow;
+}
